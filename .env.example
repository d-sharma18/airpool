# ── Supabase (free tier) → Project Settings → API ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: Google Gemini (aistudio.google.com, free, no card) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── AI backup: Groq (console.groq.com, free, no card) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Flights: Aviationstack free plan (100 calls/month, cached in Supabase) ──
AVIATIONSTACK_KEY=

# ── Aadhaar offline eKYC ──
# UIDAI's public signing certificate for offline eKYC XML (PEM). Download it from
# UIDAI's "Aadhaar Paperless Offline e-KYC" page and paste it here with \n for newlines.
UIDAI_CERT_PEM=
# Random secret used to hash Aadhaar identity (stops one Aadhaar creating many accounts).
AADHAAR_HASH_PEPPER=change-me-to-a-long-random-string
# Demo only: accept XML without a UIDAI signature check when UIDAI_CERT_PEM is empty.
ALLOW_UNSIGNED_AADHAAR=false

# ── Admin ──
# Comma-separated emails that can open /admin to review reports and block users.
ADMIN_EMAILS=you@example.com
